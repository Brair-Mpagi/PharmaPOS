# PostgreSQL Configuration
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_secure_password
POSTGRES_PORT=5432

# Application Database Users
APP_RW_USER=app_rw
APP_RW_PASSWORD=app_rw_secure_password
APP_RO_USER=app_ro_reports
APP_RO_PASSWORD=app_ro_secure_password

# Keycloak Configuration
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_secure_password
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password

# Redis Configuration
REDIS_PASSWORD=redis_secure_password
REDIS_PORT=6379

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MailHog Configuration
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Security Notes:
# 1. Copy this file to .env and update all passwords
# 2. Never commit .env to version control
# 3. Use strong passwords in production (minimum 16 characters)
# 4. Rotate passwords regularly
# 5. Use secrets management service in production (AWS Secrets Manager, Vault, etc.)
